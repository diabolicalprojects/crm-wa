# ---------------------------------------------------------------------------
# Base de datos y cola
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/database
REDIS_URL=redis://default:password@host:6379

# ---------------------------------------------------------------------------
# URLs públicas
# ---------------------------------------------------------------------------
# URL pública de la API. Con ella se arma la dirección del webhook que se
# registra en OpenWA: sin esta variable las sesiones se conectan pero NINGÚN
# mensaje llega al CRM. El arranque falla si no está configurada.
PUBLIC_API_URL=https://api.agentesia.diabolicalservices.tech

# Orígenes autorizados del frontend, separados por coma.
CORS_ORIGINS=https://agentesia.diabolicalservices.tech

# ---------------------------------------------------------------------------
# OpenWA — ver docs/openwa-contract.md
# ---------------------------------------------------------------------------
# Incluye el sufijo /api. En Dokploy conviene la dirección interna de la red
# privada (http://openwa-api:2785/api) en vez de la pública.
OPENWA_BASE_URL=https://openwa.diabolicalservices.tech/api

# Se genera en el dashboard de OpenWA, en Claves de API.
OPENWA_API_KEY=replace-me

# Secreto HMAC del webhook. OpenWA firma cada entrega con
# `X-OpenWA-Signature: sha256=<hex>`; sin él las entregas llegan sin firmar y
# cualquiera que conozca la URL puede inyectar eventos. Obligatorio en producción.
OPENWA_WEBHOOK_SECRET=replace-me

# Tiempo máximo de espera a OpenWA, en milisegundos.
OPENWA_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Seguridad
# ---------------------------------------------------------------------------
# Mínimo 32 caracteres en producción.
JWT_SECRET=replace-me-with-a-long-random-secret

# Cifra las credenciales de los proveedores de IA en la base de datos.
# Si se omite se usa JWT_SECRET; conviene separarlos para poder rotarlos aparte.
ENCRYPTION_KEY=replace-me-with-another-long-random-secret

# Protege POST /auth/bootstrap, que crea el primer superadministrador.
# Obligatorio en producción: sin él cualquiera con la URL podría reclamar la cuenta.
BOOTSTRAP_SECRET=replace-me

# ---------------------------------------------------------------------------
# Automatización de IA
# ---------------------------------------------------------------------------
# Ventana de agrupación de mensajes consecutivos del prospecto, en milisegundos.
AI_DEBOUNCE_MS=4000
AI_CONCURRENCY=4

# Las credenciales de los proveedores NO se configuran aquí: el
# superadministrador las captura desde la consola y quedan cifradas en la base
# de datos, para que cada agencia pueda tener su propia configuración.

# ---------------------------------------------------------------------------
# Google Calendar (sincronización de visitas)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.agentesia.diabolicalservices.tech/api/v1/calendar-connections/google/callback

# ---------------------------------------------------------------------------
# Frontend (build de Next.js)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.agentesia.diabolicalservices.tech/api/v1
